# Copy to .env and fill in for `docker compose up`.

# Optional: host port to publish the API on (container always listens on 4040).
ADDR_HOST_PORT=4040

# Optional: Cloudinary account used to store friend avatar images. Uploads
# fail without a valid key/secret, but the API otherwise works fine locally
# without them (friends can be created/updated without an image).
CDN_UPLOAD_URL=https://api.cloudinary.com/v1_1/sayze/image/upload
CDN_API_KEY=
CDN_API_SECRET=
